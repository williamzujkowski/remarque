---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" description="This page doesn’t exist.">
  <div class="pt-[var(--space-9)] content-reading">
    <p class="text-label">404</p>
    <h1 class="mt-3 text-display font-display text-[var(--color-fg)]">Page not found</h1>
    <p class="mt-6 text-[length:var(--text-body-lg)] text-[var(--color-fg-muted)]">
      Nothing is published at this address. It may have moved, or the link may be mistyped.
    </p>
    <ul class="mt-8 font-mono text-[length:var(--text-meta)] tracking-[var(--tracking-meta)] space-y-1">
      <li><a href={base} class="footer-link -ml-2">← Home</a></li>
      <li><a href={`${base}writing`} class="footer-link -ml-2">Writing</a></li>
      <li><a href={`${base}start`} class="footer-link -ml-2">Get started</a></li>
    </ul>
  </div>
</BaseLayout>
