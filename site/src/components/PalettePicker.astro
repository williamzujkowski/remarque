---
/**
 * Palette picker (remarque-tokens/deck + chrome.css, 0.31): the reader's
 * choice of color theme. Options come from the deck manifest that
 * remarque-deck writes at prebuild; swatches come from deck.css.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** "popover": a 44px header icon button beside the light/dark toggle
   *  (where readers look); "inline": a disclosure row, e.g. in a footer. */
  variant?: 'popover' | 'inline';
}
const { variant = 'popover' } = Astro.props;

const manifest = JSON.parse(readFileSync(join(process.cwd(), 'public', 'palettes', 'deck.json'), 'utf8'));
const palettes: { name: string; label: string }[] = manifest.palettes;
---

<details class={`remarque-deck-picker${variant === 'popover' ? ' remarque-deck-picker--popover' : ''}`} id="palette-picker">
  {variant === 'popover' ? (
    <summary aria-label="Color theme" title="Color theme" class="text-[var(--color-muted)] hover:text-[var(--color-fg)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z" />
      </svg>
      <span class="remarque-sr-only" data-deck-current>Remarque</span>
    </summary>
  ) : (
    <summary>Theme: <span data-deck-current>Remarque</span></summary>
  )}
  <fieldset>
    <legend class="remarque-sr-only">Color theme</legend>
    <label class="remarque-deck-option">
      <input type="radio" name="remarque-palette" value="" checked />
      <span class="remarque-deck-swatches" data-palette-swatch="default" aria-hidden="true"><span></span><span></span><span></span></span>
      Remarque
    </label>
    {palettes.map((p) => (
      <label class="remarque-deck-option">
        <input type="radio" name="remarque-palette" value={p.name} />
        <span class="remarque-deck-swatches" data-palette-swatch={p.name} aria-hidden="true"><span></span><span></span><span></span></span>
        {p.label}
      </label>
    ))}
  </fieldset>
</details>

<script define:vars={{ names: palettes.map((p) => p.name), labels: Object.fromEntries(palettes.map((p) => [p.name, p.label])) }}>
  window.__remarqueDeck = { names, labels };
</script>
<script>
  import { createDeck, bindPicker } from 'remarque-tokens/deck';
  const { names, labels } = (window as any).__remarqueDeck;
  const picker = document.getElementById('palette-picker')!;
  const current = picker.querySelector('[data-deck-current]')!;
  const deck = createDeck(names);
  deck.restore();
  bindPicker(deck, picker, { dismissible: true, onChange: (name) => { current.textContent = name ? labels[name] : 'Remarque'; } });
</script>
